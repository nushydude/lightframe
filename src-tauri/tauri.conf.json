{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightFrame",
  "version": "8.7.1",
  "identifier": "com.lightframe.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LightFrame",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "decorations": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost http://tauri.localhost https://tauri.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "gif",
          "bmp",
          "tiff",
          "tif",
          "heic",
          "heif",
          "avif",
          "svg",
          "dng",
          "cr2",
          "cr3",
          "nef",
          "nrw",
          "arw",
          "srf",
          "sr2",
          "raf",
          "orf",
          "rw2",
          "pef",
          "srw"
        ],
        "mimeType": "image/*",
        "name": "Image File"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "folder",
          "short": "f",
          "takesValue": true
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMUEwMzRDQjEyQkE3ODMKUldTRHB5dXhUQU1hVUNobGRKcWcrQStRd05teWtBSFVVRVdDRXhQWkpuVkthV1l2d3YwUFZMUWIK",
      "endpoints": ["https://github.com/nushydude/lightframe/releases/latest/download/latest.json"]
    }
  }
}
